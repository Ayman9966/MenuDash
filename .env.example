# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Config (Required for both Server & Client)
# Note: On Vercel, you MUST add these with the VITE_ prefix for the frontend to see them.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Server-Only (Required for Backend)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# JWT Secret for custom Auth (Required for Server)
JWT_SECRET="your-secret-key-here"

# Superadmin Credentials (Required for /login admin access)
SUPERADMIN_USERNAME="admin"
SUPERADMIN_PASSWORD="secure-password"

# Telegram Bot (Optional, for notifications)
TELEGRAM_BOT_TOKEN="your-bot-token"
